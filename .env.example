# Optional: local Codex bridge is used when this is empty.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
OPENALEX_API_KEY=
# Default local settings. A hosted service must set its exact public origin.
HOST=127.0.0.1
PORT=4180
# PUBLIC_ORIGIN=https://your-service.example
# SCHOLAR_DATA_DIR=/var/data
# Keep the API read-only until paid public access controls are in place.
# SCHOLAR_DISABLE_MODEL=1
